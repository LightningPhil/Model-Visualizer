{
  "name": "model-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "schema": "node --experimental-strip-types scripts/export-schema.ts",
    "format": "prettier --write . --ignore-path .gitignore",
    "check:models": "node --experimental-strip-types scripts/validate-model.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "katex": "0.19.0",
    "libavoid-js": "0.5.0-beta.5",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
